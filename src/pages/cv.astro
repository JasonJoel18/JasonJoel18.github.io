---
import { getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { Download, ArrowLeft, Mail, Phone, MapPin, Linkedin, Github } from 'lucide-react';

const cv = await getEntry('cv', 'cv');
const profile = await getEntry('profile', 'profile');
if (!cv || !profile) throw new Error('Missing entries');
const c = cv.data;
---

<BaseLayout
  title={`${c.name} · CV`}
  description={`Curriculum Vitae of ${c.name}. ${c.title}`}
>
  <div class="container-page pt-28 pb-20">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8 no-print">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        <ArrowLeft size={16} aria-hidden="true" />
        Back to home
      </a>
      <div class="flex items-center gap-2">
        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-2 h-10 px-4 rounded-[var(--radius)] border border-border bg-background text-sm font-medium hover:bg-muted transition-colors"
        >
          Print
        </button>
        <a
          href="/cv.pdf"
          download
          class="inline-flex items-center gap-2 h-10 px-4 rounded-[var(--radius)] bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity"
        >
          <Download size={14} aria-hidden="true" />
          Download PDF
        </a>
      </div>
    </div>

    <article class="rounded-[var(--radius)] border border-border bg-card p-6 sm:p-10 shadow-sm space-y-10 print-card">
      <header class="space-y-3 pb-6 border-b border-border">
        <h1 class="text-2xl sm:text-3xl font-medium text-balance">
          {c.name}
        </h1>
        <p class="text-base sm:text-lg text-primary font-medium">
          {c.title}
        </p>
        <p class="text-muted-foreground leading-relaxed text-pretty max-w-3xl">
          {c.summary}
        </p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted-foreground pt-2">
          <li class="inline-flex items-center gap-1.5">
            <MapPin size={14} aria-hidden="true" /> {c.contact.location}
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Mail size={14} aria-hidden="true" />
            <a href={`mailto:${c.contact.email}`} class="hover:text-primary">{c.contact.email}</a>
          </li>
          {c.contact.phone && (
            <li class="inline-flex items-center gap-1.5">
              <Phone size={14} aria-hidden="true" /> {c.contact.phone}
            </li>
          )}
          <li class="inline-flex items-center gap-1.5">
            <Linkedin size={14} aria-hidden="true" />
            <a href={c.contact.linkedin.url} target="_blank" rel="noreferrer noopener" class="hover:text-primary">
              {c.contact.linkedin.label}
            </a>
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Github size={14} aria-hidden="true" />
            <a href={c.contact.github.url} target="_blank" rel="noreferrer noopener" class="hover:text-primary">
              {c.contact.github.label}
            </a>
          </li>
        </ul>
      </header>

      <section>
        <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-primary mb-5">Experience</h2>
        <div class="space-y-8">
          {c.work.map((job) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="text-base font-semibold tracking-tight text-foreground">
                  {job.title} <span class="text-primary font-medium">@ {job.company}</span>
                </h3>
                <span class="text-sm text-muted-foreground">{job.duration} · {job.location}</span>
              </div>
              <ul class="mt-3 space-y-1.5">
                {job.points.map((p) => (
                  <li class="flex gap-3 text-muted-foreground leading-relaxed text-sm">
                    <span class="mt-2 h-1 w-1 rounded-full bg-primary shrink-0"></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-primary mb-5">Education</h2>
          <div class="space-y-5">
            {c.education.map((e) => (
              <div>
                <p class="font-semibold text-foreground tracking-tight">{e.degree}</p>
                <p class="text-sm text-primary mt-0.5">{e.institution}</p>
                <p class="text-xs text-muted-foreground mt-1">{e.duration} · {e.location}</p>
                {e.summary && <p class="text-sm text-muted-foreground mt-1">{e.summary}</p>}
              </div>
            ))}
          </div>
        </div>
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-primary mb-5">Languages</h2>
          <ul class="space-y-2">
            {c.languages.map((l) => (
              <li class="flex items-center justify-between text-sm">
                <span class="text-foreground">{l.name}</span>
                <span class="text-muted-foreground">{l.level}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section>
        <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-primary mb-5">Skills</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {c.skills.map((g) => (
            <div>
              <p class="text-sm font-semibold text-foreground mb-2">{g.category}</p>
              <ul class="flex flex-wrap gap-1.5">
                {g.items.map((it) => (
                  <li class="text-xs text-muted-foreground border border-border rounded-md px-2.5 py-0.5">
                    {it}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-primary mb-5">Certifications</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2.5">
          {c.certifications.map((cert) => (
            <li class="flex items-baseline justify-between gap-3 text-sm">
              <span class="text-foreground">{cert.name}</span>
              <span class="text-muted-foreground whitespace-nowrap">{cert.issuer}</span>
            </li>
          ))}
        </ul>
      </section>
    </article>
  </div>
</BaseLayout>
