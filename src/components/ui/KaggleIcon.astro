---
import { siKaggle } from 'simple-icons';
interface Props { size?: number; class?: string }
const { size = 18, class: className } = Astro.props;
---
<svg
  role="img"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-label="Kaggle"
  class={className}
  fill="currentColor"
>
  <title>Kaggle</title>
  <path d={siKaggle.path} />
</svg>
