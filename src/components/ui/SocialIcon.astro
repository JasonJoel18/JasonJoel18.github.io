---
import SocialIcon from './SocialIcon.tsx';

interface Props {
  kind: 'github' | 'linkedin' | 'kaggle' | 'email' | 'twitter' | 'instagram' | 'website';
  url: string;
  label: string;
  class?: string;
  size?: number;
}

const { kind, url, label, class: className, size = 18 } = Astro.props;
---

<SocialIcon client:visible kind={kind} url={url} label={label} className={className} size={size} />
