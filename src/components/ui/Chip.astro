---
import { cn } from '~/lib/cn';
interface Props {
  class?: string;
  tone?: 'default' | 'accent';
}
const { class: className, tone = 'default' } = Astro.props;
const toneClass =
  tone === 'accent'
    ? 'border-[color-mix(in_oklab,var(--color-accent)_45%,transparent)] text-[var(--color-accent)] bg-[var(--color-accent-soft)]'
    : 'border-[var(--color-border)] text-[var(--color-fg-muted)] bg-[var(--color-surface)]';
---
<span
  class={cn(
    'inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium tracking-tight',
    toneClass,
    className,
  )}
>
  <slot />
</span>
