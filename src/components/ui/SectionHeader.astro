---
import { cn } from '~/lib/cn';
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, description, align = 'left', class: className } = Astro.props;
const alignClass = align === 'center' ? 'items-center text-center' : 'items-start text-left';
---
<div class={cn('flex flex-col gap-3 mb-10 md:mb-14', alignClass, className)}>
  <div class="flex items-center gap-3 text-sm font-mono text-[var(--color-accent)]">
    <span class="h-px w-8 bg-[color-mix(in_oklab,var(--color-accent)_60%,transparent)]"></span>
    <span class="uppercase tracking-[0.18em]">{eyebrow}</span>
  </div>
  <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold text-balance tracking-tight">
    {title}
  </h2>
  {description && (
    <p class="max-w-2xl text-[var(--color-fg-muted)] text-pretty leading-relaxed">{description}</p>
  )}
</div>
