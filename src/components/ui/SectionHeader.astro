---
import { cn } from '~/lib/cn';
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, description, align = 'left', class: className } = Astro.props;
const alignClass = align === 'center' ? 'items-center text-center' : 'items-start text-left';
---
<div class={cn('flex flex-col gap-2 mb-6 sm:mb-8', alignClass, className)}>
  <div class="flex items-center gap-2.5 text-[var(--color-accent)]">
    <span class="h-px w-6 bg-[color-mix(in_oklab,var(--color-accent)_60%,transparent)]"></span>
    <span class="label-mono !text-[var(--color-accent)]">{eyebrow}</span>
  </div>
  <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-balance tracking-tight leading-tight">
    {title}
  </h2>
  {description && (
    <p class="max-w-2xl text-sm sm:text-base text-[var(--color-fg-muted)] text-pretty leading-relaxed">{description}</p>
  )}
</div>
