---
import { cn } from '~/lib/cn';
interface Props {
  value: string;
  label: string;
  tone?: 'default' | 'accent' | 'success';
  class?: string;
}
const { value, label, tone = 'default', class: className } = Astro.props;
const toneClass = {
  default: 'text-[var(--color-fg)]',
  accent: 'text-[var(--color-accent)]',
  success: 'text-[var(--color-success)]',
}[tone];
---
<div
  class={cn(
    'glass-sm rounded-lg px-3 py-2 flex flex-col items-start min-w-0',
    className,
  )}
>
  <span class={cn('text-base sm:text-lg font-semibold leading-none tracking-tight tabular-nums', toneClass)}>
    {value}
  </span>
  <span class="label-mono mt-1 truncate">{label}</span>
</div>
