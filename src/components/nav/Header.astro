---
import { getEntry } from 'astro:content';
import { Download } from 'lucide-react';
import MobileSheet from './MobileSheet.tsx';

const site = await getEntry('site', 'site');
const profile = await getEntry('profile', 'profile');
if (!site || !profile) throw new Error('Missing site/profile entries');

const { nav, cta } = site.data;
const initials = profile.data.name
  .split(' ')
  .map((s: string) => s[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('');
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-200"
>
  <div class="container-page">
    <div class="flex items-center justify-between h-16">
      <a
        href="/"
        class="inline-flex items-center gap-2 group"
        aria-label={`${profile.data.name} — Home`}
      >
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-primary text-primary-foreground text-xs font-semibold">
          {initials}
        </span>
        <span class="text-sm font-semibold tracking-tight text-foreground">
          {profile.data.name}
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {nav.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors rounded-md"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={cta.primary.href}
          download
          class="hidden md:inline-flex items-center gap-2 h-9 px-4 rounded-[var(--radius)] bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity"
        >
          <Download size={14} />
          CV
        </a>
        <MobileSheet client:idle nav={nav} cta={cta} />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    let scrolled = false;
    const onScroll = () => {
      const next = window.scrollY > 24;
      if (next !== scrolled) {
        scrolled = next;
        header.classList.toggle('is-scrolled', scrolled);
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  #site-header.is-scrolled {
    background: color-mix(in oklab, var(--background) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom-color: var(--border);
  }
</style>
