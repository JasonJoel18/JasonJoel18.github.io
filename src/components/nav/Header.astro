---
import { getEntry } from 'astro:content';
import { Download } from 'lucide-react';
import ActiveSectionNav from './ActiveSectionNav.tsx';
import MobileMenu from './MobileMenu.tsx';

const site = await getEntry('site', 'site');
const profile = await getEntry('profile', 'profile');
if (!site || !profile) throw new Error('Missing site/profile entries');

const { nav, cta } = site.data;
const initials = profile.data.name
  .split(' ')
  .map((s: string) => s[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('');
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color] duration-300 ease-out"
>
  <!-- Scroll progress bar -->
  <div class="h-px w-full bg-transparent">
    <div class="scroll-progress-bar h-px bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-2)]"></div>
  </div>

  <div class="container-wide">
    <div class="flex items-center justify-between h-16 sm:h-[72px]">
      <a
        href="/"
        class="inline-flex items-center gap-2 group"
        aria-label={`${profile.data.name} — Home`}
      >
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-fg)] group-hover:text-[var(--color-accent)] transition-colors">
          {initials} — {profile.data.name.split(' ')[0]}
        </span>
      </a>

      <ActiveSectionNav client:idle nav={nav} />

      <div class="flex items-center gap-3">
        <a
          href={cta.primary.href}
          download
          class="hidden md:inline-flex items-center gap-2 h-9 px-4 rounded-full border border-[var(--color-border-2)] text-xs font-mono uppercase tracking-[0.15em] text-[var(--color-fg)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors duration-300"
        >
          <Download size={12} strokeWidth={1.75} aria-hidden="true" />
          CV
        </a>
        <MobileMenu client:idle nav={nav} cta={cta} />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    let scrolled = false;
    const onScroll = () => {
      const y = window.scrollY;
      const next = y > 24;
      if (next !== scrolled) {
        scrolled = next;
        header.classList.toggle('is-scrolled', scrolled);
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  #site-header {
    background: color-mix(in oklab, var(--color-bg) 0%, transparent);
  }
  #site-header.is-scrolled {
    background: color-mix(in oklab, var(--color-bg) 78%, transparent);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border-bottom: 1px solid color-mix(in oklab, var(--color-border) 60%, transparent);
  }
</style>
