---
import { getEntry } from 'astro:content';
import { Download } from 'lucide-react';
import MobileSheet from './MobileSheet.tsx';
import CommandPalette from './CommandPalette.tsx';
import ThemeToggle from './ThemeToggle.tsx';

const site = await getEntry('site', 'site');
const profile = await getEntry('profile', 'profile');
if (!site || !profile) throw new Error('Missing site/profile entries');

const { nav, cta } = site.data;
const initials = profile.data.name
  .split(' ')
  .map((s: string) => s[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('');
---

<header
  id="site-header"
  class="liquid-glass fixed inset-x-0 top-0 z-50 will-change-[background,backdrop-filter]"
>
  <div class="container-page">
    <div class="flex items-center justify-between h-16">
      <a
        href="/"
        class="inline-flex items-center gap-2 group"
        aria-label={`${profile.data.name} — Home`}
      >
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-primary text-primary-foreground text-xs font-semibold">
          {initials}
        </span>
        <span class="text-sm font-semibold tracking-tight text-foreground">
          {profile.data.name}
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {nav.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors rounded-md"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <div class="hidden sm:inline-flex">
          <CommandPalette client:idle />
        </div>
        <ThemeToggle client:idle />
        <a
          href={cta.primary.href}
          download
          class="hidden md:inline-flex items-center gap-2 h-9 px-4 rounded-[var(--radius)] bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity"
        >
          <Download size={14} />
          CV
        </a>
        <MobileSheet client:idle nav={nav} cta={cta} />
      </div>
    </div>
  </div>
</header>

<script>
  // Drive the liquid-glass amount from scroll position, smoothed with rAF.
  // Scroll 0..160px maps to glass-amount 0..1 via ease-out-quart for physics-y feel.
  (function () {
    const header = document.getElementById('site-header');
    if (!header) return;

    const MAX_SCROLL = 160;
    let raf = 0;
    let current = -1;

    const easeOutQuart = (t: number) => 1 - Math.pow(1 - t, 4);

    const apply = () => {
      raf = 0;
      const y = Math.max(0, Math.min(window.scrollY, MAX_SCROLL));
      const linear = y / MAX_SCROLL;
      const eased = easeOutQuart(linear);
      // Two-decimal precision to avoid layout thrash from sub-pixel jitter.
      const rounded = Math.round(eased * 100) / 100;
      if (rounded === current) return;
      current = rounded;
      header.style.setProperty('--glass-amount', String(rounded));
    };

    const schedule = () => {
      if (raf) return;
      raf = window.requestAnimationFrame(apply);
    };

    apply();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
  })();
</script>
