---
import { getCollection } from 'astro:content';
import { Github } from 'lucide-react';
import ProjectCard from '~/components/sections/ProjectCard';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.year - a.data.year;
});

const cards = projects.map((p) => ({
  title: p.data.title,
  summary: p.data.summary,
  year: p.data.year,
  tech: p.data.tech,
  media: p.data.media,
  metrics: p.data.metrics,
  role: p.data.role,
  links: p.data.links ?? {},
  href: p.data.caseStudy ? `/projects/${p.id}/` : null,
  featured: p.data.featured,
}));
---

<section id="projects" class="relative py-16 sm:py-24 bg-muted/30 cv-auto">
  <div class="container-page">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">Selected Projects</h2>
      <p class="mt-3 text-muted-foreground max-w-2xl mx-auto text-pretty">
        BI dashboards, data automation, and ML — each shipped against a measurable target.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((project) => (
        <ProjectCard client:visible project={project} />
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <a
        href="https://github.com/JasonJoel18"
        target="_blank"
        rel="noreferrer noopener"
        class="inline-flex items-center gap-2 h-10 px-5 rounded-[var(--radius)] border border-border bg-background text-sm font-medium text-foreground hover:bg-muted transition-colors"
      >
        <Github size={16} aria-hidden="true" />
        View All Projects
      </a>
    </div>
  </div>
</section>
