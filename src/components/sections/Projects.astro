---
import { getCollection } from 'astro:content';
import { ArrowUpRight } from 'lucide-react';
import ProjectIndex, { type ProjectRow } from '~/components/sections/ProjectIndex';
import Reveal from '~/components/motion/Reveal';
import SectionHead from '~/components/ui/SectionHead.astro';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.year - a.data.year;
});

const rows: ProjectRow[] = projects.map((p) => {
  const m = p.data.media;
  let cover = '';
  let coverAlt = p.data.title;
  if (m.type === 'image' || m.type === 'gif') {
    cover = m.src;
    coverAlt = m.alt;
  } else if (m.type === 'video') {
    cover = m.poster;
    coverAlt = m.alt;
  }
  return {
    slug: p.id,
    title: p.data.title,
    year: p.data.year,
    tech: p.data.tech,
    role: p.data.role,
    featured: p.data.featured,
    cover,
    coverAlt,
  };
});
---

<section id="projects" class="relative py-20 sm:py-28 lg:py-36 cv-auto">
  <div class="container-page">
    <Reveal client:visible>
      <SectionHead
        number="03"
        label="work"
        title="Selected work."
        lede="BI dashboards, data automation, and machine learning. Each shipped against a measurable target."
        aside={`${rows.length} public commits. Client work lives in private repos.`}
      />
    </Reveal>

    <Reveal client:visible className="mt-16">
      <ProjectIndex client:load projects={rows} />
    </Reveal>

    <Reveal client:visible className="mt-16 flex justify-start" delay={0.1}>
      <a
        href="https://github.com/JasonJoel18"
        target="_blank"
        rel="noreferrer noopener"
        class="group inline-flex items-center gap-2 text-sm font-medium text-foreground border-b border-border pb-1 hover:border-primary transition-colors"
      >
        See everything on GitHub
        <ArrowUpRight size={15} aria-hidden="true" className="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
    </Reveal>
  </div>
</section>
