---
import { getCollection } from 'astro:content';
import { ArrowUpRight } from 'lucide-react';
import ProjectCard from '~/components/sections/ProjectCard';
import Reveal from '~/components/motion/Reveal';
import SectionHead from '~/components/ui/SectionHead.astro';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.year - a.data.year;
});

const cards = projects.map((p) => ({
  title: p.data.title,
  summary: p.data.summary,
  year: p.data.year,
  tech: p.data.tech,
  media: p.data.media,
  metrics: p.data.metrics,
  role: p.data.role,
  links: p.data.links ?? {},
  href: p.data.caseStudy ? `/projects/${p.id}/` : null,
  featured: p.data.featured,
}));
---

<section id="projects" class="relative py-28 sm:py-36 cv-auto">
  <div class="container-page">
    <Reveal client:visible>
      <SectionHead
        number="03"
        label="work"
        title="Selected work."
        lede="BI dashboards, data automation, and machine learning. Each shipped against a measurable target."
        aside={`${cards.length} public commits. Client work lives in private repos.`}
      />
    </Reveal>

    <div class="mt-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
      {cards.map((project, i) => (
        <ProjectCard client:visible project={project} index={i} />
      ))}
    </div>

    <Reveal client:visible className="mt-16 flex justify-start" delay={0.1}>
      <a
        href="https://github.com/JasonJoel18"
        target="_blank"
        rel="noreferrer noopener"
        class="group inline-flex items-center gap-2 text-sm font-medium text-foreground border-b border-border pb-1 hover:border-primary transition-colors"
      >
        See everything on GitHub
        <ArrowUpRight size={15} aria-hidden="true" className="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
    </Reveal>
  </div>
</section>
