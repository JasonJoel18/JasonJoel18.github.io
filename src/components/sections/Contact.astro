---
import { getEntry } from 'astro:content';
import { ArrowUpRight } from 'lucide-react';
import Reveal from '~/components/motion/Reveal.tsx';
import MagneticButton from '~/components/motion/MagneticButton.tsx';
import SocialIcon from '~/components/ui/SocialIcon.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing profile entry');

const email = profile.data.socials.find((s) => s.kind === 'email');
const emailAddress = email?.label ?? '';
---

<section id="contact" class="relative min-h-screen flex flex-col justify-center py-28 sm:py-40">
  <div class="container-wide w-full">
    <div class="flex items-baseline gap-6 mb-12 sm:mb-16">
      <span class="label-mono">06 — Contact</span>
      <Reveal client:visible variant="draw-line" className="hairline flex-1" amount={0.4}>
        <span class="block h-px"></span>
      </Reveal>
    </div>

    <Reveal
      client:visible
      as="h2"
      variant="stagger-words"
      text="Let's build something measurable."
      className="display-italic text-[clamp(3rem,11vw,12rem)] text-[var(--color-fg)] leading-[0.95] text-balance max-w-[15ch]"
    />

    <p class="mt-12 max-w-2xl text-lg sm:text-xl text-[var(--color-fg-muted)] leading-relaxed">
      Currently {profile.data.availability.toLowerCase()}. If you have a data problem worth solving — or just want to swap notes on dashboards — my inbox is open.
    </p>

    {email && (
      <div class="mt-16 sm:mt-20">
        <p class="label-mono mb-4">Email</p>
        <MagneticButton
          client:visible
          href={email.url}
          ariaLabel="Send an email"
          strength={14}
          className="display-italic inline-flex items-baseline gap-3 text-[clamp(2rem,6vw,5.5rem)] leading-[1] text-[var(--color-fg)] hover:text-[var(--color-accent)] transition-colors duration-300"
        >
          <span class="draw-underline">{emailAddress}</span>
          <ArrowUpRight size={32} strokeWidth={1} aria-hidden="true" />
        </MagneticButton>
      </div>
    )}

    <div class="mt-16 sm:mt-20 flex items-center gap-2">
      {profile.data.socials.filter((s) => s.kind !== 'email').map((s) => (
        <SocialIcon kind={s.kind} url={s.url} label={s.label} class="h-10 w-10" />
      ))}
    </div>
  </div>
</section>
