---
import { Database, LineChart, Layers, Zap } from 'lucide-react';

const stats = [
  { icon: 'lineChart', value: '15+', label: 'Dashboards shipped', detail: 'Tableau · Power BI · Plotly' },
  { icon: 'database',  value: '200+', label: 'SQL queries in production', detail: 'MySQL · SAP HANA' },
  { icon: 'zap',       value: '40%', label: 'Avg. efficiency uplift', detail: 'Across BI engagements' },
  { icon: 'layers',    value: '3+',  label: 'Years in BI & analytics', detail: 'Plus M.Sc. in Data Science' },
];
---
<section class="container-page relative z-10 -mt-6 sm:-mt-10 mb-10 sm:mb-16">
  <div class="glass-panel grid grid-cols-2 lg:grid-cols-4 divide-y lg:divide-y-0 lg:divide-x divide-[var(--color-border)] overflow-hidden">
    {stats.map((s) => (
      <div class="px-4 py-4 sm:px-6 sm:py-5 flex items-start gap-3 group">
        <div class="shrink-0 w-9 h-9 rounded-md grid place-items-center bg-[var(--color-accent-soft)] text-[var(--color-accent)] group-hover:scale-105 transition-transform duration-300">
          {s.icon === 'lineChart' && <LineChart size={18} strokeWidth={1.5} />}
          {s.icon === 'database'  && <Database  size={18} strokeWidth={1.5} />}
          {s.icon === 'zap'       && <Zap       size={18} strokeWidth={1.5} />}
          {s.icon === 'layers'    && <Layers    size={18} strokeWidth={1.5} />}
        </div>
        <div class="min-w-0">
          <div class="text-2xl sm:text-3xl font-semibold leading-none tabular-nums tracking-tight">{s.value}</div>
          <div class="text-xs sm:text-sm text-[var(--color-fg)] mt-1.5 leading-snug">{s.label}</div>
          <div class="label-mono mt-1 truncate">{s.detail}</div>
        </div>
      </div>
    ))}
  </div>
</section>
