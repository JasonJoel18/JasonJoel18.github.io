---
import { getEntry } from 'astro:content';
import { ArrowRight, Download, MapPin } from 'lucide-react';
import HeroIntro from '~/components/motion/HeroIntro.tsx';
import MagneticButton from '~/components/motion/MagneticButton.tsx';
import SocialIcon from '~/components/ui/SocialIcon.astro';

const profile = await getEntry('profile', 'profile');
const site = await getEntry('site', 'site');
if (!profile || !site) throw new Error('Missing entries');
const p = profile.data;
const cta = site.data.cta;
---

<section
  id="hero"
  class="relative min-h-screen flex items-center pt-32 pb-20 overflow-hidden"
>
  <!-- Decorative glow blobs (static, GPU-friendly, no animation) -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -left-40 h-[520px] w-[520px] rounded-full opacity-60"
    style="background: radial-gradient(closest-side, rgba(167,139,250,0.35), transparent 70%); filter: blur(40px);"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-20 right-[-160px] h-[460px] w-[460px] rounded-full opacity-50"
    style="background: radial-gradient(closest-side, rgba(34,211,238,0.30), transparent 70%); filter: blur(40px);"
  ></div>

  <div class="container-page grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-12 lg:gap-16 items-center relative">
    <div>
      <HeroIntro
        client:load
        name={p.name}
        title={p.title}
        subtitle={p.heroSubtitle}
        tagline={p.heroTagline}
        available={p.availability}
      />

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <MagneticButton
          client:visible
          href={cta.primary.href}
          download
          ariaLabel="Download CV"
          className="inline-flex items-center gap-2 h-12 px-6 rounded-full bg-[var(--color-fg)] text-[var(--color-bg)] font-medium tracking-tight shadow-[0_10px_40px_-15px_rgba(255,255,255,0.5)]"
        >
          <Download size={16} aria-hidden="true" />
          {cta.primary.label}
        </MagneticButton>

        <a
          href={cta.secondary.href}
          class="inline-flex items-center gap-2 h-12 px-6 rounded-full border border-[var(--color-border-2)] text-[var(--color-fg)] font-medium tracking-tight transition-[transform,border-color,color] duration-300 ease-out will-change-transform hover:-translate-y-0.5 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          {cta.secondary.label}
          <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>

      <div class="mt-10 flex items-center gap-4 text-sm text-[var(--color-fg-subtle)]">
        <span class="inline-flex items-center gap-1.5">
          <MapPin size={14} aria-hidden="true" />
          {p.location}
        </span>
        <span class="h-px w-8 bg-[var(--color-border)]"></span>
        <div class="flex items-center gap-1.5">
          {p.socials.map((s) => (
            <SocialIcon kind={s.kind} url={s.url} label={s.label} class="h-9 w-9" />
          ))}
        </div>
      </div>
    </div>

    <div class="relative mx-auto lg:mx-0">
      <div
        class="absolute -inset-4 rounded-full opacity-70 blur-2xl"
        style="background: conic-gradient(from 90deg, rgba(167,139,250,0.5), rgba(34,211,238,0.4), rgba(167,139,250,0.5));"
        aria-hidden="true"
      ></div>
      <div class="relative h-64 w-64 sm:h-80 sm:w-80 rounded-full overflow-hidden border border-[var(--color-border-2)] glass">
        <img
          src={p.avatar}
          alt={`Portrait of ${p.name}`}
          width="320"
          height="320"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-xs font-mono text-[var(--color-fg-subtle)] tracking-widest uppercase no-print"
    aria-hidden="true"
  >
    <span class="inline-flex items-center gap-2">
      <span>Scroll</span>
      <span class="h-8 w-px bg-gradient-to-b from-[var(--color-fg-subtle)] to-transparent"></span>
    </span>
  </div>
</section>
