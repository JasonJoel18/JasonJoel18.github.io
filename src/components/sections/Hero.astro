---
import { getEntry } from 'astro:content';
import { ArrowRight, Download, FileText, MapPin, Wrench, Briefcase } from 'lucide-react';
import HeroIntro from '~/components/motion/HeroIntro.tsx';
import MagneticButton from '~/components/motion/MagneticButton.tsx';
import MotionIcon from '~/components/ui/MotionIcon.tsx';
import SocialIcon from '~/components/ui/SocialIcon.astro';

const profile = await getEntry('profile', 'profile');
const site = await getEntry('site', 'site');
if (!profile || !site) throw new Error('Missing entries');
const p = profile.data;
const cta = site.data.cta;
const proof = p.heroProof ?? [];
const proofIcons = [MapPin, Wrench, Briefcase];
---

<section
  id="hero"
  class="relative min-h-[100svh] flex flex-col justify-center pt-28 pb-12 sm:pt-32 sm:pb-16 overflow-hidden"
>
  <div class="container-wide relative z-10">
    <div class="flex items-center gap-3 mb-6 sm:mb-8">
      <div class="text-xs text-[var(--color-fg-muted)] flex items-center gap-2 font-mono">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inset-0 rounded-full bg-[var(--color-success)] opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[var(--color-success)]"></span>
        </span>
        {p.location} — {p.availability}
      </div>
    </div>
  </div>

  <div class="container-wide grid grid-cols-1 md:grid-cols-[260px_1fr] lg:grid-cols-[320px_1fr] gap-8 md:gap-12 lg:gap-16 items-center relative z-10">
    <!-- Portrait -->
    <div class="order-1 md:order-1 mx-auto md:mx-0 w-44 sm:w-56 md:w-full max-w-[20rem]">
      <div class="relative aspect-square rounded-2xl overflow-hidden ring-1 ring-[var(--color-border-2)] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.5)]">
        <img
          src={p.avatar}
          alt={`Portrait of ${p.name}`}
          width="640"
          height="640"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </div>

    <!-- Copy -->
    <div class="order-2 md:order-2 min-w-0">
      <HeroIntro
        client:load
        name={p.name}
        title={p.title}
        subtitle={p.heroSubtitle}
        tagline={p.heroTagline}
      />

      <ul class="mt-6 sm:mt-8 space-y-2 text-sm sm:text-base text-[var(--color-fg)]">
        {proof.map((line, i) => {
          const Icon = proofIcons[i] ?? MapPin;
          return (
            <li class="flex items-center gap-3">
              <MotionIcon client:visible icon={Icon} size={15} className="text-[var(--color-accent)]" />
              <span>{line}</span>
            </li>
          );
        })}
      </ul>

      <div class="mt-7 sm:mt-9 flex flex-wrap items-center gap-3">
        <MagneticButton
          client:visible
          href={cta.primary.href}
          download
          ariaLabel="Download CV"
          strength={12}
          className="inline-flex items-center gap-2 h-11 px-5 rounded-full bg-[var(--color-fg)] text-[var(--color-bg)] font-medium tracking-tight text-sm shadow-[0_20px_60px_-20px_rgba(255,255,255,0.4)]"
        >
          <MotionIcon client:visible icon={Download} size={15} reveal={false} />
          {cta.primary.label}
        </MagneticButton>

        <MagneticButton
          client:visible
          href={cta.secondary.href}
          ariaLabel={cta.secondary.label}
          strength={10}
          className="inline-flex items-center gap-2 h-11 px-5 rounded-full border border-[var(--color-border-2)] text-[var(--color-fg)] font-medium tracking-tight text-sm hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors duration-300"
        >
          {cta.secondary.label}
          <MotionIcon client:visible icon={ArrowRight} size={15} reveal={false} />
        </MagneticButton>

        <a
          href="/cv"
          class="inline-flex items-center gap-2 h-11 px-3 rounded-full text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] transition-colors duration-300"
        >
          <MotionIcon client:visible icon={FileText} size={15} reveal={false} />
          View CV
        </a>

        <div class="flex items-center gap-1 ml-1">
          {p.socials.map((s) => (
            <SocialIcon kind={s.kind} url={s.url} label={s.label} class="h-9 w-9" />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
