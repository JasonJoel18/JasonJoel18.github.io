---
import fs from 'node:fs';
import path from 'node:path';
import { getEntry } from 'astro:content';
import { ArrowDown } from 'lucide-react';
import HeroIntro from '~/components/motion/HeroIntro';
import Terminal from '~/components/motion/Terminal';
import Reveal from '~/components/motion/Reveal';

const profile = await getEntry('profile', 'profile');
const site = await getEntry('site', 'site');
if (!profile || !site) throw new Error('Missing entries');
const p = profile.data;

const nameParts = p.name.trim().split(/\s+/);
const lastWord = nameParts.pop()!;
const firstWords = nameParts.join(' ');

// Compute CV size at build time so the download confirmation shows real bytes.
let cvSizeKb = 0;
try {
  const cvPath = path.resolve(process.cwd(), 'public/cv.pdf');
  cvSizeKb = Math.round(fs.statSync(cvPath).size / 1024);
} catch (_) {
  cvSizeKb = 0;
}

const terminalLines = [
  { prompt: '$ ', text: 'whoami' },
  { text: 'jason joel pinto — data analyst, berlin', output: true },
  { prompt: '$ ', text: 'cat focus.txt', responseDelay: 220 },
  { text: 'sql · python · ml · tableau · power bi · sap hana', output: true },
  { prompt: '$ ', text: 'status --availability', responseDelay: 220 },
  { text: '✓ open to roles where data drives decisions', output: true },
];
---

<section
  id="hero"
  class="relative min-h-[90svh] flex flex-col items-center justify-center pt-32 pb-20 text-center overflow-hidden"
>
  <div class="container-page w-full">
    <HeroIntro
      client:load
      firstWords={firstWords}
      lastWord={lastWord}
      tagline={p.heroTagline ?? p.title}
      subtitle={p.heroSubtitle}
      location={p.location}
      availability={p.availability}
      socials={p.socials}
      cvHref={site.data.cta.primary.href}
      cvSizeKb={cvSizeKb}
    />

    <Reveal client:visible delay={0.55} className="mt-12 max-w-xl mx-auto text-left">
      <Terminal client:visible title="jason@portfolio:~" lines={terminalLines} />
    </Reveal>
  </div>

  <a
    href="#about"
    aria-label="Scroll to about"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 text-muted-foreground hover:text-foreground transition-colors"
  >
    <ArrowDown size={22} className="animate-nudge" />
  </a>
</section>
