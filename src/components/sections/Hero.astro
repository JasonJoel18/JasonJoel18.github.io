---
import { getEntry } from 'astro:content';
import { ArrowRight, Download } from 'lucide-react';
import HeroIntro from '~/components/motion/HeroIntro.tsx';
import MagneticButton from '~/components/motion/MagneticButton.tsx';
import VerticalMarquee from '~/components/motion/VerticalMarquee.tsx';
import SocialIcon from '~/components/ui/SocialIcon.astro';

const profile = await getEntry('profile', 'profile');
const site = await getEntry('site', 'site');
if (!profile || !site) throw new Error('Missing entries');
const p = profile.data;
const cta = site.data.cta;

const roles = (p.heroTagline ?? '').split('·').map((s: string) => s.trim()).filter(Boolean);
const marqueeRoles = roles.length > 0 ? roles : ['Data Analyst', 'BI Engineer', 'ML Practitioner'];
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col justify-center pt-32 pb-20 overflow-hidden"
>
  <!-- Avatar chip top-left -->
  <div class="container-wide relative z-10">
    <div class="flex items-center gap-3 mb-12 sm:mb-16">
      <div class="relative h-10 w-10 rounded-full overflow-hidden border border-[var(--color-border-2)] shrink-0">
        <img
          src={p.avatar}
          alt={`Portrait of ${p.name}`}
          width="40"
          height="40"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="text-xs text-[var(--color-fg-muted)] flex items-center gap-2 font-mono">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inset-0 rounded-full bg-[var(--color-success)] opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[var(--color-success)]"></span>
        </span>
        {p.location} — {p.availability}
      </div>
    </div>
  </div>

  <div class="container-wide grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 items-end relative z-10">
    <div class="min-w-0">
      <HeroIntro
        client:load
        name={p.name}
        title={p.title}
        subtitle={p.heroSubtitle}
        tagline={p.heroTagline}
      />

      <div class="mt-10 sm:mt-12 flex flex-wrap items-center gap-3">
        <MagneticButton
          client:visible
          href={cta.primary.href}
          download
          ariaLabel="Download CV"
          strength={12}
          className="inline-flex items-center gap-2 h-12 px-6 rounded-full bg-[var(--color-fg)] text-[var(--color-bg)] font-medium tracking-tight text-sm shadow-[0_20px_60px_-20px_rgba(255,255,255,0.4)]"
        >
          <Download size={15} strokeWidth={1.75} aria-hidden="true" />
          {cta.primary.label}
        </MagneticButton>

        <MagneticButton
          client:visible
          href={cta.secondary.href}
          ariaLabel={cta.secondary.label}
          strength={10}
          className="inline-flex items-center gap-2 h-12 px-6 rounded-full border border-[var(--color-border-2)] text-[var(--color-fg)] font-medium tracking-tight text-sm hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors duration-300"
        >
          {cta.secondary.label}
          <ArrowRight size={15} strokeWidth={1.75} aria-hidden="true" />
        </MagneticButton>

        <div class="flex items-center gap-1 ml-2">
          {p.socials.map((s) => (
            <SocialIcon kind={s.kind} url={s.url} label={s.label} class="h-9 w-9" />
          ))}
        </div>
      </div>
    </div>

    <!-- Vertical role marquee — desktop only -->
    <aside class="hidden lg:block self-center max-h-[50vh] w-[180px]">
      <VerticalMarquee client:visible items={marqueeRoles} duration={26} />
    </aside>
  </div>
</section>
