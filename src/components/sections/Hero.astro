---
import { getEntry } from 'astro:content';
import { ArrowRight, Download, MapPin } from 'lucide-react';
import HeroIntro from '~/components/motion/HeroIntro.tsx';
import HeroDashboard from '~/components/motion/HeroDashboard.tsx';
import MagneticButton from '~/components/motion/MagneticButton.tsx';
import SocialIcon from '~/components/ui/SocialIcon.astro';

const profile = await getEntry('profile', 'profile');
const site = await getEntry('site', 'site');
if (!profile || !site) throw new Error('Missing entries');
const p = profile.data;
const cta = site.data.cta;
---

<section
  id="hero"
  class="relative min-h-[calc(100vh-4rem)] flex items-center pt-24 pb-12 sm:pt-28 sm:pb-16 overflow-hidden"
>
  <!-- Decorative glow blobs -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -left-40 h-[520px] w-[520px] rounded-full opacity-60"
    style="background: radial-gradient(closest-side, rgba(167,139,250,0.32), transparent 70%); filter: blur(50px);"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-20 right-[-180px] h-[480px] w-[480px] rounded-full opacity-50"
    style="background: radial-gradient(closest-side, rgba(34,211,238,0.28), transparent 70%); filter: blur(50px);"
  ></div>

  <div class="container-wide grid grid-cols-1 lg:grid-cols-[1.05fr_1fr] gap-10 lg:gap-12 items-center relative">
    <div class="min-w-0">
      <div class="flex items-center gap-3 mb-6">
        <div class="relative h-12 w-12 sm:h-14 sm:w-14 rounded-full overflow-hidden border border-[var(--color-border-2)] glass shrink-0">
          <img
            src={p.avatar}
            alt={`Portrait of ${p.name}`}
            width="56"
            height="56"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="min-w-0">
          <div class="label-mono">{p.location}</div>
          <div class="text-xs text-[var(--color-fg-muted)] flex items-center gap-1.5">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inset-0 rounded-full bg-[var(--color-success)] opacity-75 animate-ping"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[var(--color-success)]"></span>
            </span>
            {p.availability}
          </div>
        </div>
      </div>

      <HeroIntro
        client:load
        name={p.name}
        title={p.title}
        subtitle={p.heroSubtitle}
        tagline={p.heroTagline}
      />

      <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-3">
        <MagneticButton
          client:visible
          href={cta.primary.href}
          download
          ariaLabel="Download CV"
          className="inline-flex items-center gap-2 h-11 px-5 rounded-full bg-[var(--color-fg)] text-[var(--color-bg)] font-medium tracking-tight text-sm shadow-[0_10px_40px_-15px_rgba(255,255,255,0.5)]"
        >
          <Download size={15} strokeWidth={1.75} aria-hidden="true" />
          {cta.primary.label}
        </MagneticButton>

        <a
          href={cta.secondary.href}
          class="glass-sm inline-flex items-center gap-2 h-11 px-5 rounded-full text-[var(--color-fg)] font-medium tracking-tight text-sm transition-[transform,border-color,color] duration-300 ease-out will-change-transform hover:-translate-y-0.5 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          {cta.secondary.label}
          <ArrowRight size={15} strokeWidth={1.75} aria-hidden="true" />
        </a>

        <div class="flex items-center gap-1 ml-1">
          {p.socials.map((s) => (
            <SocialIcon kind={s.kind} url={s.url} label={s.label} class="h-9 w-9" />
          ))}
        </div>
      </div>
    </div>

    <div class="relative">
      <HeroDashboard client:load />
    </div>
  </div>
</section>
