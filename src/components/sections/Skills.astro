---
import { getEntry } from 'astro:content';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import Reveal from '~/components/motion/Reveal.tsx';

const cv = await getEntry('cv', 'cv');
if (!cv) throw new Error('Missing cv entry');
---

<section id="skills" class="py-24 sm:py-32 cv-auto">
  <div class="container-page">
    <SectionHeader
      eyebrow="Toolbox"
      title="Tools I reach for."
      description="The day-to-day stack across analysis, modeling, visualization, and the soft layer that makes the outputs land."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {cv.data.skills.map((group, i) => (
        <Reveal client:visible delay={i * 0.04} className="card p-6">
          <p class="text-sm font-mono text-[var(--color-accent)] tracking-[0.18em] uppercase mb-4">
            {group.category}
          </p>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li
                class="text-sm text-[var(--color-fg)] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-full px-3 py-1.5 transition-colors duration-300 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
              >
                {item}
              </li>
            ))}
          </ul>
        </Reveal>
      ))}
    </div>
  </div>
</section>
