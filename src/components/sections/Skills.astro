---
import { toolGroups } from '~/lib/tool-groups';
import ToolIcon from '~/components/ui/ToolIcon.astro';

const stats = [
  { value: '15+', label: 'Projects shipped' },
  { value: '3+',  label: 'Years experience' },
  { value: '30+', label: 'Technologies' },
];
---

<section id="skills" class="relative py-16 sm:py-24 cv-auto">
  <div class="container-page">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">Skills &amp; Tools</h2>
      <p class="mt-3 text-muted-foreground max-w-2xl mx-auto text-pretty">
        The stack I reach for, organized by where it sits in the workflow.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {toolGroups.map((group) => (
        <div class="rounded-[var(--radius)] border border-border bg-card p-5 shadow-sm">
          <h3 class="text-sm font-semibold text-foreground mb-4">{group.label}</h3>
          <div class="flex flex-wrap gap-x-4 gap-y-3">
            {group.tools.map((tool) => (
              <div class="inline-flex items-center gap-2" title={tool.title}>
                <ToolIcon title={tool.title} path={tool.path} hex={tool.hex} size={20} />
                <span class="text-xs text-muted-foreground">{tool.title}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 grid grid-cols-3 gap-4 max-w-2xl mx-auto text-center">
      {stats.map((s) => (
        <div>
          <div class="text-3xl sm:text-4xl font-semibold text-foreground tabular-nums">{s.value}</div>
          <div class="mt-1 text-xs sm:text-sm text-muted-foreground">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
