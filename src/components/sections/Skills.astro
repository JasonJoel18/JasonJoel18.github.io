---
import Reveal from '~/components/motion/Reveal.tsx';
import ToolGrid from '~/components/sections/ToolGrid.astro';
---

<section id="skills" class="relative py-16 sm:py-24 cv-auto">
  <div class="container-wide">
    <div class="mb-6 sm:mb-8">
      <span class="label-mono">04 — Stack</span>
    </div>
    <Reveal
      client:visible
      as="h2"
      variant="stagger-words"
      text="The tools I reach for."
      className="display-italic text-[clamp(1.75rem,3.6vw,3.25rem)] text-[var(--color-fg)] leading-[1.1] max-w-[22ch] mb-8 sm:mb-10"
    />
  </div>

  <ToolGrid />
</section>
