---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import Reveal from '~/components/motion/Reveal.tsx';
import ToolGrid from '~/components/sections/ToolGrid.astro';
---

<section id="skills" class="py-14 sm:py-20 cv-auto">
  <div class="container-wide">
    <SectionHeader
      eyebrow="Stack"
      title="Tools & technologies."
      description="Five years of stack iteration distilled — from SQL warehouses to ML pipelines to executive-grade dashboards."
    />

    <Reveal client:visible className="glass-panel p-5 sm:p-7">
      <ToolGrid />
    </Reveal>
  </div>
</section>
