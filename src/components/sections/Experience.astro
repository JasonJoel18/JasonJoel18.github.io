---
import { getEntry } from 'astro:content';
import ExperienceTabs from '~/components/sections/Experience.tsx';
import Reveal from '~/components/motion/Reveal';
import SectionHead from '~/components/ui/SectionHead.astro';

const cv = await getEntry('cv', 'cv');
if (!cv) throw new Error('Missing cv entry');
---

<section id="experience" class="relative py-20 sm:py-28 lg:py-36 bg-muted/30 cv-auto">
  <div class="container-page">
    <Reveal client:visible>
      <SectionHead
        number="04"
        label="experience"
        title="Where I've been."
        lede="Three years of shipping data products, plus the academic background behind it."
        aside="Most recent first. Toggle between work and the academic side."
      />
    </Reveal>

    <div class="mt-20">
      <ExperienceTabs client:visible work={cv.data.work} education={cv.data.education} />
    </div>
  </div>
</section>
