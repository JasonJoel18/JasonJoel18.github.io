---
import { getEntry } from 'astro:content';
import Reveal from '~/components/motion/Reveal.tsx';
import ExperienceChapters from './ExperienceChapters.tsx';

const cv = await getEntry('cv', 'cv');
if (!cv) throw new Error('Missing cv entry');
---

<section id="experience" class="relative cv-auto">
  <div class="container-wide pt-28 sm:pt-40 pb-10">
    <div class="flex items-baseline gap-6 mb-12">
      <span class="label-mono">02 — Experience</span>
      <Reveal client:visible variant="draw-line" className="hairline flex-1" amount={0.4}>
        <span class="block h-px"></span>
      </Reveal>
    </div>
    <Reveal
      client:visible
      as="h2"
      variant="stagger-words"
      text="Three years shipping data products."
      className="display-italic text-[clamp(2rem,5vw,4.5rem)] text-[var(--color-fg)] leading-[1.05] max-w-[22ch]"
    />
  </div>

  <ExperienceChapters client:visible jobs={cv.data.work} />
</section>
