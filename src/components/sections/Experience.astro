---
import { getEntry } from 'astro:content';
import ExperienceTabs from '~/components/sections/Experience.tsx';

const cv = await getEntry('cv', 'cv');
if (!cv) throw new Error('Missing cv entry');
---

<section id="experience" class="relative py-16 sm:py-24 cv-auto">
  <div class="container-page">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">Experience &amp; Education</h2>
      <p class="mt-3 text-muted-foreground max-w-2xl mx-auto text-pretty">
        Three years shipping data products, plus the academic background behind it.
      </p>
    </div>

    <ExperienceTabs client:visible work={cv.data.work} education={cv.data.education} />
  </div>
</section>
