---
import { getEntry } from 'astro:content';
import Reveal from '~/components/motion/Reveal.tsx';

const cv = await getEntry('cv', 'cv');
if (!cv) throw new Error('Missing cv entry');
---

<section id="education" class="relative py-16 sm:py-24 cv-auto">
  <div class="container-wide">
    <div class="mb-6 sm:mb-8">
      <span class="label-mono">05 — Credentials</span>
    </div>

    <Reveal
      client:visible
      as="h2"
      variant="stagger-words"
      text="Education and certifications."
      className="display-italic text-[clamp(1.75rem,3.6vw,3.25rem)] text-[var(--color-fg)] leading-[1.1] max-w-[22ch] mb-8 sm:mb-10"
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <Reveal client:visible variant="fade" className="space-y-5">
        <p class="label-mono text-[var(--color-accent)]">Education</p>
        <ol class="space-y-6">
          {cv.data.education.map((e) => (
            <li class="pt-4 border-t border-[color-mix(in_oklab,var(--color-border-2)_60%,transparent)]">
              <div class="flex items-baseline justify-between gap-3 mb-1.5">
                <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-fg-subtle)]">{e.duration}</span>
                <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-fg-subtle)]">{e.location}</span>
              </div>
              <h3 class="display-italic text-xl sm:text-2xl text-[var(--color-fg)] leading-tight">{e.degree}</h3>
              <p class="text-sm sm:text-base text-[var(--color-accent)] mt-1">{e.institution}</p>
              {e.summary && <p class="text-sm sm:text-base text-[var(--color-fg-muted)] mt-2 leading-relaxed max-w-prose">{e.summary}</p>}
            </li>
          ))}
        </ol>
      </Reveal>

      <Reveal client:visible variant="fade" delay={0.1} className="space-y-5">
        <p class="label-mono text-[var(--color-accent)]">Certifications</p>
        <ul>
          {cv.data.certifications.map((c) => (
            <li class="group flex items-baseline justify-between gap-4 py-3 border-t border-[color-mix(in_oklab,var(--color-border-2)_60%,transparent)] cursor-default">
              <span class="display-italic text-base sm:text-lg text-[var(--color-fg)] leading-snug">{c.name}</span>
              <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-fg-subtle)] shrink-0 group-hover:text-[var(--color-accent)] transition-colors">
                {c.issuer}{c.year ? ` · ${c.year}` : ''}
              </span>
            </li>
          ))}
        </ul>
      </Reveal>
    </div>
  </div>
</section>
