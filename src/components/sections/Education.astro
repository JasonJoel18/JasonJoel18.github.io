---
import { getEntry } from 'astro:content';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import Reveal from '~/components/motion/Reveal.tsx';
import { GraduationCap, Award } from 'lucide-react';

const cv = await getEntry('cv', 'cv');
if (!cv) throw new Error('Missing cv entry');
---

<section id="education" class="py-14 sm:py-20 cv-auto">
  <div class="container-wide">
    <SectionHeader eyebrow="Credentials" title="Education & certifications." />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      <Reveal client:visible className="space-y-3">
        <div class="flex items-center gap-2 text-[var(--color-fg)]">
          <GraduationCap size={16} strokeWidth={1.5} className="text-[var(--color-accent)]" aria-hidden="true" />
          <h3 class="label-mono !text-[var(--color-accent)] !text-xs">Education</h3>
        </div>
        <div class="space-y-3">
          {cv.data.education.map((e) => (
            <div class="glass-panel p-4 sm:p-5">
              <div class="flex items-start justify-between gap-3 mb-1">
                <p class="text-sm sm:text-base font-semibold text-[var(--color-fg)] tracking-tight leading-snug">{e.degree}</p>
                <span class="label-mono shrink-0">{e.duration}</span>
              </div>
              <p class="text-xs sm:text-sm text-[var(--color-accent)]">{e.institution}</p>
              <p class="label-mono mt-1">{e.location}</p>
              {e.summary && <p class="text-xs sm:text-sm text-[var(--color-fg-muted)] mt-2 leading-relaxed">{e.summary}</p>}
            </div>
          ))}
        </div>
      </Reveal>

      <Reveal client:visible delay={0.05} className="space-y-3">
        <div class="flex items-center gap-2 text-[var(--color-fg)]">
          <Award size={16} strokeWidth={1.5} className="text-[var(--color-accent)]" aria-hidden="true" />
          <h3 class="label-mono !text-[var(--color-accent)] !text-xs">Certifications</h3>
        </div>
        <ul class="glass-panel p-4 sm:p-5 divide-y divide-[var(--color-border)]">
          {cv.data.certifications.map((c) => (
            <li class="py-2.5 first:pt-0 last:pb-0 flex items-baseline justify-between gap-3">
              <span class="text-sm text-[var(--color-fg)] leading-snug">{c.name}</span>
              <span class="label-mono shrink-0">{c.issuer}{c.year ? ` · ${c.year}` : ''}</span>
            </li>
          ))}
        </ul>
      </Reveal>
    </div>
  </div>
</section>
