---
import { getEntry } from 'astro:content';
import Reveal from '~/components/motion/Reveal.tsx';

const cv = await getEntry('cv', 'cv');
if (!cv) throw new Error('Missing cv entry');
---

<section id="education" class="relative py-28 sm:py-40 cv-auto">
  <div class="container-wide">
    <div class="flex items-baseline gap-6 mb-12 sm:mb-16">
      <span class="label-mono">05 — Credentials</span>
      <Reveal client:visible variant="draw-line" className="hairline flex-1" amount={0.4}>
        <span class="block h-px"></span>
      </Reveal>
    </div>

    <Reveal
      client:visible
      as="h2"
      variant="stagger-words"
      text="Education and certifications."
      className="display-italic text-[clamp(2.25rem,5.5vw,5rem)] text-[var(--color-fg)] leading-[1.04] max-w-[22ch] mb-16 sm:mb-20"
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
      <Reveal client:visible variant="fade" className="space-y-10">
        <p class="label-mono text-[var(--color-accent)]">Education</p>
        <ol class="space-y-10">
          {cv.data.education.map((e) => (
            <li class="pt-6 border-t border-[color-mix(in_oklab,var(--color-border-2)_60%,transparent)]">
              <div class="flex items-baseline justify-between gap-3 mb-2">
                <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-fg-subtle)]">{e.duration}</span>
                <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-fg-subtle)]">{e.location}</span>
              </div>
              <h3 class="display-italic text-3xl sm:text-4xl text-[var(--color-fg)] leading-tight">{e.degree}</h3>
              <p class="text-base text-[var(--color-accent)] mt-1">{e.institution}</p>
              {e.summary && <p class="text-base text-[var(--color-fg-muted)] mt-3 leading-relaxed max-w-prose">{e.summary}</p>}
            </li>
          ))}
        </ol>
      </Reveal>

      <Reveal client:visible variant="fade" delay={0.1} className="space-y-6">
        <p class="label-mono text-[var(--color-accent)]">Certifications</p>
        <ul>
          {cv.data.certifications.map((c) => (
            <li class="group flex items-baseline justify-between gap-4 py-4 border-t border-[color-mix(in_oklab,var(--color-border-2)_60%,transparent)] cursor-default">
              <span class="display-italic text-xl sm:text-2xl text-[var(--color-fg)] leading-snug">{c.name}</span>
              <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-fg-subtle)] shrink-0 group-hover:text-[var(--color-accent)] transition-colors">
                {c.issuer}{c.year ? ` · ${c.year}` : ''}
              </span>
            </li>
          ))}
        </ul>
      </Reveal>
    </div>
  </div>
</section>
