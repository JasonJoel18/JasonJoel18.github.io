---
import { getEntry } from 'astro:content';
import { Brain, Database, TrendingUp } from 'lucide-react';
import Reveal from '~/components/motion/Reveal';
import SectionHead from '~/components/ui/SectionHead.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing profile entry');

const focusAreas = [
  {
    icon: Brain,
    title: 'Machine Learning',
    body: 'Predictive modeling, classification, and uncertainty-aware deep learning. Historical data turned into forward-looking signal.',
  },
  {
    icon: Database,
    title: 'Data Engineering',
    body: 'SQL pipelines across MySQL and SAP HANA, stored procedures, Python automation that replaces hours of manual reporting.',
  },
  {
    icon: TrendingUp,
    title: 'Analytics & Insights',
    body: 'Dashboards in Tableau, Power BI, and Plotly Dash that land with C-suite stakeholders and drive measurable change.',
  },
];
---

<section id="about" class="relative py-20 sm:py-28 lg:py-36 cv-auto">
  <div class="container-page">
    <Reveal client:visible>
      <SectionHead
        number="01"
        label="about"
        title="About."
        lede="Decision-grade analytics across BI, data engineering, and machine learning. Three years of shipping the work behind the chart."
        aside="Happiest with a SQL window function open in one tab and a notebook in another."
      />
    </Reveal>

    <div class="mt-20 grid grid-cols-12 gap-x-8 gap-y-16">
      <div
        data-reveal-cascade
        class="col-span-12 lg:col-span-7 lg:col-start-1 space-y-6 max-w-[62ch]"
        style="--cascade-step: 60ms;"
      >
        {profile.data.about.map((para, i) => (
          <p
            data-reveal-item
            style={`--i:${i};`}
            class="text-[15px] sm:text-base text-muted-foreground leading-[1.75] text-pretty"
          >
            {para}
          </p>
        ))}
      </div>

      <ol
        data-reveal-cascade
        class="col-span-12 lg:col-span-5 lg:col-start-8 space-y-10"
        style="--cascade-step: 80ms;"
      >
        {focusAreas.map(({ icon: Icon, title, body }, i) => (
          <li
            data-reveal-item
            style={`--i:${i};`}
            class="group grid grid-cols-[auto_1fr] gap-x-5"
          >
            <div class="flex flex-col items-center pt-1">
              <Icon
                size={18}
                aria-hidden="true"
                className="text-primary/80 transition-transform duration-300 group-hover:translate-y-[-1px]"
              />
              <span class="mt-2 font-mono text-[10px] tabular-nums text-muted-foreground/60 tracking-wider">
                0{i + 1}
              </span>
            </div>
            <div class="min-w-0 border-l border-border/60 pl-5">
              <h3 class="text-base font-semibold text-foreground">{title}</h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed max-w-[42ch]">
                {body}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
