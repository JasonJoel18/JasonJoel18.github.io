---
import { getEntry } from 'astro:content';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import Reveal from '~/components/motion/Reveal.tsx';
import { MapPin, Languages, Briefcase } from 'lucide-react';

const profile = await getEntry('profile', 'profile');
const cv = await getEntry('cv', 'cv');
if (!profile || !cv) throw new Error('Missing entries');
---

<section id="about" class="py-24 sm:py-32 cv-auto">
  <div class="container-page">
    <SectionHeader eyebrow="About" title="A short version of the long story." />

    <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-10 lg:gap-16">
      <Reveal client:visible className="space-y-5 text-[var(--color-fg-muted)] text-lg leading-relaxed text-pretty">
        {profile.data.about.map((p) => <p>{p}</p>)}
      </Reveal>

      <Reveal client:visible delay={0.1} className="space-y-4">
        <div class="card p-5 flex items-start gap-3">
          <MapPin size={18} className="text-[var(--color-accent)] mt-0.5 shrink-0" aria-hidden="true" />
          <div>
            <p class="text-sm text-[var(--color-fg-subtle)]">Based in</p>
            <p class="text-[var(--color-fg)] font-medium">{profile.data.location}</p>
          </div>
        </div>
        <div class="card p-5 flex items-start gap-3">
          <Briefcase size={18} className="text-[var(--color-accent)] mt-0.5 shrink-0" aria-hidden="true" />
          <div>
            <p class="text-sm text-[var(--color-fg-subtle)]">Status</p>
            <p class="text-[var(--color-fg)] font-medium">{profile.data.availability}</p>
          </div>
        </div>
        <div class="card p-5">
          <div class="flex items-start gap-3">
            <Languages size={18} className="text-[var(--color-accent)] mt-0.5 shrink-0" aria-hidden="true" />
            <div class="flex-1">
              <p class="text-sm text-[var(--color-fg-subtle)] mb-2">Languages</p>
              <ul class="space-y-1.5">
                {cv.data.languages.map((l) => (
                  <li class="flex items-center justify-between text-sm">
                    <span class="text-[var(--color-fg)]">{l.name}</span>
                    <span class="text-[var(--color-fg-subtle)]">{l.level}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>
