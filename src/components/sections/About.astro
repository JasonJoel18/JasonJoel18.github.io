---
import { getEntry } from 'astro:content';
import { Brain, Database, TrendingUp } from 'lucide-react';

const profile = await getEntry('profile', 'profile');
const cv = await getEntry('cv', 'cv');
if (!profile || !cv) throw new Error('Missing entries');

const technical = cv.data.skills.find((s) => s.category === 'Technical Skills')?.items ?? [];
const tools = cv.data.skills.find((s) => s.category === 'Tools & Platforms')?.items ?? [];
const chips = [...technical.slice(0, 3), ...tools.slice(0, 3)];

const focusCards = [
  {
    icon: Brain,
    title: 'Machine Learning',
    body: 'Predictive modeling, classification, and uncertainty-aware deep learning — turning historical data into forward-looking signals.',
  },
  {
    icon: Database,
    title: 'Data Engineering',
    body: 'SQL pipelines across MySQL and SAP HANA, stored procedures, and Python automation that cut hours of manual reporting.',
  },
  {
    icon: TrendingUp,
    title: 'Analytics & Insights',
    body: 'BI dashboards in Tableau, Power BI, and Plotly Dash that land with C-suite stakeholders and drive measurable change.',
  },
];
---

<section id="about" class="relative py-16 sm:py-24 bg-muted/30 cv-auto">
  <div class="container-page">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">About Me</h2>
      <p class="mt-3 text-muted-foreground max-w-2xl mx-auto text-pretty">
        Building decision-grade analytics across BI, data engineering, and machine learning.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <div class="space-y-5">
        {profile.data.about.map((para) => (
          <p class="text-muted-foreground leading-relaxed text-pretty">{para}</p>
        ))}
        {chips.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {chips.map((c) => (
              <span class="inline-flex items-center rounded-md border border-border bg-background px-2.5 py-1 text-xs font-medium text-foreground">
                {c}
              </span>
            ))}
          </div>
        )}
      </div>

      <div class="space-y-4">
        {focusCards.map(({ icon: Icon, title, body }) => (
          <div class="flex items-start gap-4 rounded-[var(--radius)] border border-border bg-card p-5 shadow-sm">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[var(--radius)] bg-primary/10 text-primary">
              <Icon size={20} aria-hidden="true" />
            </div>
            <div>
              <h3 class="text-base font-semibold text-foreground">{title}</h3>
              <p class="mt-1 text-sm text-muted-foreground leading-relaxed">{body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
