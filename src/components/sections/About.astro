---
import { getEntry } from 'astro:content';
import Reveal from '~/components/motion/Reveal.tsx';

const profile = await getEntry('profile', 'profile');
const cv = await getEntry('cv', 'cv');
if (!profile || !cv) throw new Error('Missing entries');

const latestEdu = cv.data.education[0];
const paragraphs = profile.data.about as string[];
const pullQuote = paragraphs[0] ?? '';
const runningCopy = paragraphs.slice(1);
---

<section id="about" class="relative py-28 sm:py-40 cv-auto">
  <div class="container-wide">
    <div class="flex items-baseline gap-6 mb-12 sm:mb-16">
      <span class="label-mono">01 — About</span>
      <Reveal client:visible variant="draw-line" className="hairline flex-1" amount={0.4}>
        <span class="block h-px"></span>
      </Reveal>
    </div>

    <Reveal
      client:visible
      as="p"
      variant="stagger-words"
      text={pullQuote}
      className="display-italic text-[clamp(2rem,5.6vw,5.5rem)] leading-[1.05] text-[var(--color-fg)] text-balance max-w-[20ch]"
    />

    <div class="mt-20 sm:mt-28 grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-20">
      <Reveal
        client:visible
        variant="fade"
        className="space-y-6 text-[var(--color-fg-muted)] text-lg leading-relaxed text-pretty max-w-2xl"
      >
        {runningCopy.map((p) => <p>{p}</p>)}
      </Reveal>

      <Reveal client:visible variant="rise" delay={0.1} className="space-y-8">
        <dl class="space-y-6">
          <div>
            <dt class="label-mono mb-1.5">Based in</dt>
            <dd class="display-italic text-2xl text-[var(--color-fg)]">{profile.data.location}</dd>
          </div>
          <div>
            <dt class="label-mono mb-1.5">Status</dt>
            <dd class="text-base text-[var(--color-fg)]">{profile.data.availability}</dd>
          </div>
          {latestEdu && (
            <div>
              <dt class="label-mono mb-1.5">Currently</dt>
              <dd class="text-base text-[var(--color-fg)]">{latestEdu.degree}</dd>
              <dd class="text-sm text-[var(--color-fg-subtle)]">{latestEdu.institution}</dd>
            </div>
          )}
          <div>
            <dt class="label-mono mb-1.5">Languages</dt>
            <dd class="space-y-1">
              {cv.data.languages.map((l) => (
                <div class="flex items-baseline justify-between gap-3 text-base">
                  <span class="text-[var(--color-fg)]">{l.name}</span>
                  <span class="font-mono text-xs text-[var(--color-fg-subtle)] tracking-wider uppercase">{l.level}</span>
                </div>
              ))}
            </dd>
          </div>
        </dl>
      </Reveal>
    </div>
  </div>
</section>
