---
import '~/styles/globals.css';
import Header from '~/components/nav/Header.astro';
import Footer from '~/components/nav/Footer.astro';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noHeader?: boolean;
  noFooter?: boolean;
}

const site = await getEntry('site', 'site');
const profile = await getEntry('profile', 'profile');
if (!site || !profile) throw new Error('Missing site/profile content collection entries');

const seo = site.data.seo;
const {
  title = seo.title,
  description = seo.description,
  ogImage = seo.ogImage,
  noHeader = false,
  noFooter = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageAbsolute = new URL(ogImage, Astro.site).toString();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.data.name,
  jobTitle: profile.data.title,
  url: Astro.site?.toString(),
  image: new URL(profile.data.avatar, Astro.site).toString(),
  address: { '@type': 'PostalAddress', addressLocality: profile.data.location },
  sameAs: profile.data.socials
    .filter((s) => s.kind !== 'email')
    .map((s) => s.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1a1d" />

    <script is:inline>
      // Apply persisted theme before paint to prevent flash of wrong theme.
      // Dark is the explicit default; only an explicit 'light' choice opts out.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored !== 'light';
          if (dark) document.documentElement.classList.add('dark');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#1a1a1d' : '#fafafa');
        } catch (_) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      // Scroll-triggered cascade reveal: one observer for all groups.
      // Fires once per group, no autonomous motion, honours reduced-motion via CSS.
      (function () {
        if (typeof IntersectionObserver === 'undefined') {
          document
            .querySelectorAll('[data-reveal-cascade]')
            .forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        function attach() {
          document
            .querySelectorAll('[data-reveal-cascade]:not(.is-in)')
            .forEach(function (el) { io.observe(el); });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', attach, { once: true });
        } else {
          attach();
        }
      })();
    </script>

    <script is:inline>
      // Console signature for curious devs.
      try {
        if (typeof console !== 'undefined' && console.log) {
          const title = ['',
            '   ▌ ▄▖▄▖▖▖   ▌ ▄▖▄▖▖    ▄▖▄▖▖ ▖▄▖▄▖',
            '   ▌ ▌▌▐ ▌▌   ▌ ▌▌▙▖▌    ▙▌▐ ▛▌▐ ▌▌▐ ',
            '▗▖▙▖▛▌▟▖▛▘▗▖▗▖▙▖▙▌▙▖▙▖▗▖▌    ▐ ▌▌▐ ▙▌▐ ',
            ''].join('\n');
          const cssTitle = 'color:#3b53d6; font-weight:600; font-family:JetBrains Mono,monospace; line-height:1.15;';
          const cssLabel = 'color:#3b53d6; background:#eef0fb; padding:2px 6px; border-radius:3px; font:600 11px JetBrains Mono,monospace; letter-spacing:0.12em;';
          const cssMeta  = 'color:#1f2937; font:13px Inter Tight,sans-serif;';
          const cssMuted = 'color:#6b7280; font:12px Inter Tight,sans-serif;';
          const cssMono  = 'color:#3b53d6; font:600 13px JetBrains Mono,monospace;';
          const cssRule  = 'color:#d1d5db; font:11px JetBrains Mono,monospace;';

          console.log('%c' + title, cssTitle);
          console.log('%c HELLO ', cssLabel, '');
          console.log('%cJason Joel Pinto · Data Analyst · Berlin', cssMeta);
          console.log('%c────────────────────────────────────────', cssRule);
          console.log('%cCurious enough to open DevTools — that already says a lot.', cssMuted);
          console.log('%cOpen to analytics + ML roles where data drives decisions.', cssMuted);
          console.log(' ');
          console.log('%cjasonjoel1899@gmail.com', cssMono);
          console.log(' ');
          console.log('%cbuilt with  %cAstro · React · Framer Motion · Tailwind v4', cssMuted, cssMeta);
          console.log('%csource      %chttps://github.com/JasonJoel18/JasonJoel18.github.io', cssMuted, cssMeta);
        }
      } catch (_) { /* never let a console flourish break the page */ }
    </script>
  </head>
  <body class="bg-background text-foreground antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:px-3 focus:py-2 focus:rounded-md focus:bg-primary focus:text-primary-foreground"
    >
      Skip to content
    </a>

    {!noHeader && <Header />}

    <main id="main">
      <slot />
    </main>

    {!noFooter && <Footer />}
  </body>
</html>
