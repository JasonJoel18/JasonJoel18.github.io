---
import '~/styles/globals.css';
import Header from '~/components/nav/Header.astro';
import Footer from '~/components/nav/Footer.astro';
import CursorSpotlight from '~/components/gl/CursorSpotlight.tsx';
import MeshGradient from '~/components/gl/MeshGradient.tsx';
import SmoothScroll from '~/components/motion/SmoothScroll.tsx';
import PageTransition from '~/components/motion/PageTransition.tsx';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noHeader?: boolean;
  noFooter?: boolean;
}

const site = await getEntry('site', 'site');
const profile = await getEntry('profile', 'profile');
if (!site || !profile) throw new Error('Missing site/profile content collection entries');

const seo = site.data.seo;
const {
  title = seo.title,
  description = seo.description,
  ogImage = seo.ogImage,
  noHeader = false,
  noFooter = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageAbsolute = new URL(ogImage, Astro.site).toString();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.data.name,
  jobTitle: profile.data.title,
  url: Astro.site?.toString(),
  image: new URL(profile.data.avatar, Astro.site).toString(),
  address: { '@type': 'PostalAddress', addressLocality: profile.data.location },
  sameAs: profile.data.socials
    .filter((s) => s.kind !== 'email')
    .map((s) => s.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050507" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Editorial type stack: Instrument Serif (display), Inter Tight (UI), JetBrains Mono (mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      />
    </noscript>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="text-[var(--color-fg)] antialiased">
    <MeshGradient client:only="react" />
    <CursorSpotlight client:only="react" />
    <SmoothScroll client:idle />
    <PageTransition client:only="react" />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:px-3 focus:py-2 focus:rounded-md focus:bg-white focus:text-black"
    >
      Skip to content
    </a>

    {!noHeader && <Header />}

    <main id="main" class="relative z-10">
      <slot />
    </main>

    {!noFooter && <Footer />}
  </body>
</html>
